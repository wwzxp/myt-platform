node_modules/
dist/
*.log

# 只读参考源码（dsh），不参与构建
reference/

# 本地数据（设备状态、探测产物）
data/

# 打包中间产物
build_temp/
release/

# 构建产物（tsc 中间件 + tsdown 打包结果）
lib/
*.tsbuildinfo

# 临时脚本与产物
.tmp/

# 前端构建缓存
.rsbuild/
.vite/

# vendor 里的 tsc 输出（源码是 .ts，旁边生成的 js/d.ts 不入库）
vendor/*/src/*.js
vendor/*/src/*.js.map
vendor/*/src/*.d.ts
vendor/*/src/*.d.ts.map
