{
  "name": "@myt/kernel",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:~",
    "@deepseek-ai/dsh-agent-loop": "workspace:~",
    "@deepseek-ai/dsh-llm": "workspace:~",
    "@deepseek-ai/dsh-scope": "workspace:~",
    "@deepseek-ai/dsh-session": "workspace:~",
    "@deepseek-ai/dsh-system-prompt": "workspace:~",
    "@deepseek-ai/dsh-tools": "workspace:~",
    "@myt/automation": "workspace:*",
    "@myt/device": "workspace:*",
    "@myt/device-adb": "workspace:*",
    "@myt/devices": "workspace:*",
    "@myt/flow": "workspace:*",
    "@myt/flow-xhs": "workspace:*",
    "@myt/flow-xhs-device": "workspace:*",
    "@myt/flow-xhs-publish": "workspace:*",
    "@myt/human": "workspace:*",
    "@myt/locator": "workspace:*",
    "@myt/myt-api-v2": "workspace:*",
    "@myt/myt-api-v3": "workspace:*",
    "@myt/myt-host": "workspace:*",
    "@myt/runs": "workspace:*",
    "@myt/webserver": "workspace:*",
    "@myt/workflows": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "types": "lib/types/index.d.ts",
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "src"
  ]
}